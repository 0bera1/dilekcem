{
  "name": "dilekcem",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite-react-ssg build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test --project=desktop --project=mobile",
    "test:e2e:smoke": "playwright test e2e/smoke.spec.ts --project=desktop",
    "test:a11y": "playwright test e2e/a11y.spec.ts",
    "test:pdf": "vitest run --config vitest.pdf.config.ts",
    "lighthouse": "lhci autorun --config=lighthouserc.cjs && lhci autorun --config=lighthouserc.desktop.cjs",
    "check:links": "node scripts/check-links.mjs",
    "check:data": "tsx scripts/check-data.ts",
    "check:secrets": "node scripts/check-secrets.mjs",
    "prepare": "husky",
    "audit": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "date-fns": "^4.4.0",
    "docx": "^9.14.0",
    "ics": "^3.12.1",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.1.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "beasties": "^0.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "jszip": "^3.10.2",
    "linkinator": "^8.1.0",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.88.0",
    "pdfjs-dist": "^6.4.299",
    "prettier": "^3.9.10",
    "secretlint": "^13.1.0",
    "subset-font": "^2.9.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vite-react-ssg": "^0.9.2",
    "vitest": "^5.0.5"
  },
  "description": "Hazır dilekçe ve başvuru metni sitesi. Tüm işlem tarayıcıda yapılır.",
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,css,md,html}": "prettier --write",
    "*.{ts,tsx}": "eslint --fix"
  },
  "engines": {
    "node": ">=22"
  }
}
